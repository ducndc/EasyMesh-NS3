@startuml DG_Steering_VHT
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #666666
skinparam ArrowThickness 1.2

skinparam ActivityBackgroundColor #FFF8E1
skinparam ActivityBorderColor #D4A800
skinparam ActivityBorderThickness 1.2
skinparam ActivityDiamondBackgroundColor #FFF3CD
skinparam ActivityDiamondBorderColor #D4A800
skinparam ActivityStartColor #E57373
skinparam ActivityEndColor #E57373

title DG Steering VHT

start

:Info of STA;
:Get current channel, RSSI uplink,\nstate of STA;

if (Current radio is 2G?) then (No)
  end
else (Yes)
  if (Overload on radio 2G?) then (No)
    end
  else (Yes)

    if (STA is active?) then (Yes)
      :Calculate DG Threshold\n(active, downlink rate);
      if (RSSI > DG Threshold?) then (No)
        end
      else (Yes)
        if (Downlink rate > DL_Thresh?) then (No)
          :Measure 11k, send 11k request to STA;
          #CE93D8:Wait 11k response from STA;
          if (11k success?) then (Yes)
            #FFCC80:Build & Send BTM request to STA;
          else (No)
            if (Radio not restrict?) then (Yes)
              #FFCC80:Build & Send BTM request to STA;
            else (No)
              end
            endif
          endif
        else (Yes)
          #FFCC80:Build & Send BTM request to STA;
        endif
      endif

    else (No)
      :Calculate DG Threshold\n(idle mode);
      if (RSSI > DG Threshold?) then (No)
        #FFCDD2:Prohibit DG of STA with timer;
        end
      else (Yes)
        :Measure 11k, send 11k request to STA;
        #CE93D8:Wait 11k response from STA;
        if (11k success?) then (Yes)
          #FFCC80:Build & Send BTM request to STA;
        else (No)
          if (Radio not restrict?) then (Yes)
            #FFCC80:Build & Send BTM request to STA;
          else (No)
            end
          endif
        endif
      endif
    endif

    #CE93D8:Wait BTM response from STA;

    if (Status code = 0?) then (Yes)
      end
    else (No)
      if (Retry BTM < 2?) then (Yes)
        :Wait timer 3s;
        #FFCC80:Build & Send BTM request to STA;
        #CE93D8:Wait BTM response from STA;
        if (Status code = 0?) then (Yes)
          end
        else (No)
          #FFCDD2:Prohibit DG of STA with timer;
          end
        endif
      else (No)
        #FFCDD2:Prohibit DG of STA with timer;
        end
      endif
    endif

  endif
endif

@enduml
